# ---------------------------------------------------------------------------
# Strategic Trade Analyzer — example environment
# Copy to .env and fill in.  NEVER commit .env.
# ---------------------------------------------------------------------------

APP_ENV=development
# Host port the dashboard is published on.
DASHBOARD_HOST_PORT=3000
# API URL baked into the dashboard's client bundle at build time.
PUBLIC_API_URL=http://localhost:8000
# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Authentication ---------------------------------------------------
# Generate a real secret for anything beyond local development, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# The app refuses to start with the placeholder below when APP_ENV=production.
JWT_SECRET=dev-only-insecure-secret-change-me
JWT_EXPIRY_MINUTES=720

# First-run admin account. Created on startup if both are set and no user
# with this username already exists. Leave unset once you have real users.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=change-me-immediately

# --- AI Analyst (optional) ---------------------------------------------
# A read-only assistant over the platform's own records. Leave blank to
# disable -- every other feature works with no key set.
ANTHROPIC_API_KEY=
AI_ANALYST_MODEL=claude-opus-5
APP_NAME="Strategic Trade Analyzer"
LOG_LEVEL=INFO
LOG_FORMAT=json
# Host port the API is published on.
API_HOST_PORT=8000

# --- Database -------------------------------------------------------------
POSTGRES_USER=sta
POSTGRES_PASSWORD=sta_dev_password
POSTGRES_DB=sta
POSTGRES_HOST=localhost
# Port the application connects to. For local development this must match
# POSTGRES_HOST_PORT below.
POSTGRES_PORT=5432
# Host port the Docker container publishes on. Change both if you already run
# PostgreSQL locally on 5432.
POSTGRES_HOST_PORT=5432

# --- Execution ------------------------------------------------------------
# paper  = simulated fills, no credentials needed (default)
# testnet = Binance USDT-M Futures Testnet, requires the keys below
BROKER=paper

# Real-money trading is NOT implemented. This flag exists only so the value is
# explicit in config; setting it true does not enable live execution.
ALLOW_LIVE_TRADING=false

# --- Binance Futures Testnet (only needed when BROKER=testnet) -------------
# Keys from https://testnet.binancefuture.com
BINANCE_API_KEY=
BINANCE_API_SECRET=

# --- Paper broker ---------------------------------------------------------
PAPER_STARTING_BALANCE=100000
PAPER_COMMISSION_RATE=0.0004
PAPER_SLIPPAGE_BPS=2
