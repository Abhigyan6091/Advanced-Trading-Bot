# ---------------------------------------------------------------------------
# Strategic Trade Analyzer — example environment
# Copy to .env and fill in.  NEVER commit .env.
# ---------------------------------------------------------------------------

APP_ENV=development
APP_NAME="Strategic Trade Analyzer"
LOG_LEVEL=INFO
LOG_FORMAT=json
# Host port the API is published on.
API_HOST_PORT=8000

# --- Database -------------------------------------------------------------
POSTGRES_USER=sta
POSTGRES_PASSWORD=sta_dev_password
POSTGRES_DB=sta
POSTGRES_HOST=localhost
# Port the application connects to. For local development this must match
# POSTGRES_HOST_PORT below.
POSTGRES_PORT=5432
# Host port the Docker container publishes on. Change both if you already run
# PostgreSQL locally on 5432.
POSTGRES_HOST_PORT=5432

# --- Execution ------------------------------------------------------------
# paper  = simulated fills, no credentials needed (default)
# testnet = Binance USDT-M Futures Testnet, requires the keys below
BROKER=paper

# Real-money trading is NOT implemented. This flag exists only so the value is
# explicit in config; setting it true does not enable live execution.
ALLOW_LIVE_TRADING=false

# --- Binance Futures Testnet (only needed when BROKER=testnet) -------------
# Keys from https://testnet.binancefuture.com
BINANCE_API_KEY=
BINANCE_API_SECRET=

# --- Paper broker ---------------------------------------------------------
PAPER_STARTING_BALANCE=100000
PAPER_COMMISSION_RATE=0.0004
PAPER_SLIPPAGE_BPS=2
